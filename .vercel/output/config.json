{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"headers": {
				"cache-control": "no-store"
			},
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/api/airtable/signup/?(?:/__data.json)?$",
			"dest": "/api/airtable/signup"
		},
		{
			"src": "^/api/airtable/verification/?(?:/__data.json)?$",
			"dest": "/api/airtable/verification"
		},
		{
			"src": "^/api/auth/callback/?(?:/__data.json)?$",
			"dest": "/api/auth/callback"
		},
		{
			"src": "^/api/auth/redirect/?(?:/__data.json)?$",
			"dest": "/api/auth/redirect"
		},
		{
			"src": "^/api/fillout/poc-auth/?(?:/__data.json)?$",
			"dest": "/api/fillout/poc-auth"
		},
		{
			"src": "^/api/fillout/poc-submit/?(?:/__data.json)?$",
			"dest": "/api/fillout/poc-submit"
		},
		{
			"src": "^/api/geo/?(?:/__data.json)?$",
			"dest": "/api/geo"
		},
		{
			"src": "^/api/nearest-event/?(?:/__data.json)?$",
			"dest": "/api/nearest-event"
		},
		{
			"src": "^/api/signups/?(?:/__data.json)?$",
			"dest": "/api/signups"
		},
		{
			"src": "^/api/slack/events/?(?:/__data.json)?$",
			"dest": "/api/slack/events"
		},
		{
			"src": "^/asbury-park/?(?:/__data.json)?$",
			"dest": "/(redirects)/asbury-park"
		},
		{
			"src": "^/branding/?(?:/__data.json)?$",
			"dest": "/branding"
		},
		{
			"src": "^/burlington/?(?:/__data.json)?$",
			"dest": "/(redirects)/burlington"
		},
		{
			"src": "^/docs/?(?:/__data.json)?$",
			"dest": "/docs"
		},
		{
			"src": "^/helsinki/?(?:/__data.json)?$",
			"dest": "/(cities)/helsinki"
		},
		{
			"src": "^/hong-kong/?(?:/__data.json)?$",
			"dest": "/(redirects)/hong-kong"
		},
		{
			"src": "^/lyon/?(?:/__data.json)?$",
			"dest": "/(redirects)/lyon"
		},
		{
			"src": "^/map/?(?:/__data.json)?$",
			"dest": "/map"
		},
		{
			"src": "^/shirt/?(?:/__data.json)?$",
			"dest": "/shirt"
		},
		{
			"src": "^/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/(cities)/[slug]"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}